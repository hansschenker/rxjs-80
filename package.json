{
  "name": "rxjs-80",
  "version": "0.1.0",
  "description": "80 RxJS operator names, organized by behavioral family and explicit policy configuration.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hansschenker/rxjs-80.git"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./controls": {
      "types": "./dist/controls.d.ts",
      "import": "./dist/controls.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inventory": "node scripts/inventory.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run inventory",
    "prepack": "npm run build",
    "dev": "vitepress dev docs",
    "docs:generate": "node scripts/docs.mjs",
    "docs:check": "node scripts/docs.mjs --check",
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run docs:check && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "fast-check": "3.23.2",
    "rxjs": "7.8.2",
    "typescript": "5.8.3",
    "vitepress": "1.6.4",
    "vitest": "3.0.7"
  }
}
